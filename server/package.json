    "nodemailer": "^6.10.0",
    "zod": "^3.24.0"
  },
  "optionalDependencies": {
    "@elysia/node": "^1.2.0"
  },
  "devDependencies": {
    "@types/mysql2": "github:types/mysql2",
    "@types/nodemailer": "^6.4.0",
    "bun-types": "latest",
    "tsx": "latest"
  }
}
