# ===== Runtime =====
NODE_ENV=development
HOST=127.0.0.1
PORT=3001

# ===== Database (MySQL HIS `sik`) =====
# Production: must NOT be root — startup fails fast if it is.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sik
DB_USERNAME=root
DB_PASSWORD=

# ===== Frontend (CORS origin) =====
FRONTEND_URL=http://localhost:5173

# ===== Mail (Brevo SMTP) =====
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=RSUD

# ===== API Key untuk Jadwal Dokter =====
DOCTOR_SCHEDULE_API_KEY=majumundurok

# ===== Reserved (tokens are random strings stored in DB, JWT unused) =====
# JWT_SECRET=
