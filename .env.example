# ============================================================
# Contoh env — salin ke .env lalu isi
# ============================================================
# Switch backend cukup ubah 1 variabel:
#   BACKEND_MODE=elysia  -> Vite proxy ke http://127.0.0.1:3001 (server/)
#   BACKEND_MODE=laravel -> Vite proxy ke $LARAVEL_API_URL (SIMRS rsud-tgms)
# ============================================================

# ===== Pilih backend =====
BACKEND_MODE=elysia
LARAVEL_API_URL=http://localhost/rsud-tgms/api

# ===== Branding (frontend) =====
VITE_APP_NAME=SIBANG
VITE_HOSPITAL_NAME=RSUD
VITE_HOSPITAL_ADDRESS=Jl. Contoh No.1
VITE_HOSPITAL_PHONE=+62-21-0000-0000
VITE_HOSPITAL_EMAIL=info@example.com

# ===== Frontend API (via Vite proxy — jangan diubah) =====
VITE_PORTAL_API_URL=/v1/portal
VITE_DOCTOR_SCHEDULE_API_URL=/api/jadwal-dokter
VITE_DOCTOR_SCHEDULE_API_KEY=majumundurok

# ===== Backend Elysia (dibaca server/) =====
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
FRONTEND_URL=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sik
DB_USERNAME=root
DB_PASSWORD=

MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=RSUD

DOCTOR_SCHEDULE_API_KEY=majumundurok
